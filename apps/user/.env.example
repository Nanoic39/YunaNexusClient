# 用户端环境配置（复制为 .env.local 后按需修改）

# 运行模式：development=本地联调（可用 Mock）/ production=生产（强制真实数据）
# 留空时按 Vite 的 dev / build 自动推断
VITE_APP_ENV=development

# 是否启用 MSW Mock：仅开发模式生效（生产模式强制关闭，禁止 Mock 兜底）
VITE_ENABLE_MOCK=true

# 接口基础路径：开发环境留空表示同源（走 vite proxy / mock）；
# 生产环境填入真实网关地址（如 https://api.example.com）
VITE_API_BASE_URL=

# 是否启用 CSRF 令牌回显（后端开启时同步打开）
VITE_ENABLE_CSRF=false

# 管理端地址：顶栏「进入管理后台」的跳转目标（仅持有根角色 admin 的用户可见）。
# 开发环境留空即可（默认走 http://localhost:5173）；生产环境必须显式配置。
VITE_ADMIN_URL=
