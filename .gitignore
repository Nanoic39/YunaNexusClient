*.suo
*.ntvs*
*.njsproj
*.sln

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# Public production settings only; never put secrets in VITE_* variables.
!**/.env.production
output/
*.pem
*.key
*.pfx
*.p12

release/
.devhome/
.devhome*
