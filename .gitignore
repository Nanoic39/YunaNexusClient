# 依赖
node_modules/
.pnpm-store/
.pnpm-cache/

# 构建产物
dist/
dist-ssr/
*.local
.vite/
.turbo/

# 环境变量（本地覆盖不入库；仅 .env.example 入库）
.env
.env.*
!.env.example

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
