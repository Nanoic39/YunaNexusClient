{
  "name": "yunanexus-client",
  "version": "0.1.0",
  "private": true,
  "description": "YunaNexus 前端 · 用户端与管理端（Vite + Vue 3 + Naive UI）",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @yuna/admin dev",
    "dev:user": "pnpm --filter @yuna/user dev",
    "build": "pnpm --filter @yuna/admin build && pnpm --filter @yuna/user build",
    "build:admin": "pnpm --filter @yuna/admin build",
    "build:user": "pnpm --filter @yuna/user build",
    "preview:admin": "pnpm --filter @yuna/admin preview",
    "preview:user": "pnpm --filter @yuna/user preview",
    "typecheck": "pnpm -r typecheck",
    "msw:init": "pnpm --filter @yuna/core exec msw init ../../apps/admin/public --save && pnpm --filter @yuna/core exec msw init ../../apps/user/public --save",
    "format": "prettier --write \"**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "3.2.6"
  }
}
